NODE_ENV=development
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# server-only
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jomini
SUPABASE_SERVICE_ROLE_KEY=

# auth
JWT_ACCESS_SECRET=change-me-32-bytes-min-change-me
JWT_REFRESH_SECRET=change-me-32-bytes-min-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_DOMAIN=localhost

# external contract (must match the legacy CustomAuth token for FlowXO)
CUSTOM_AUTH_TOKEN=

# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_GROUP_ID=
TELEGRAM_SUPPLIER_BSG_GROUP_ID=
TELEGRAM_SUPPLIER_NICK_GROUP_ID=
TELEGRAM_WEBHOOK_TOKEN=
TELEGRAM_BUTTON_URL=http://localhost:3000

# flowxo
FLOWXO_CALLBACK_URL=

# misc
DEFAULT_TZ=Asia/Kuala_Lumpur
LOG_LEVEL=info

# supplier API poller (set to 0 to disable background polling; min effective 5000ms)
SUPPLIER_API_POLL_INTERVAL_MS=30000

# auto-run seed + legacy data migration on every server start (tracked in bootstrap_state table)
# set to 0 to disable
DB_BOOTSTRAP_ON_START=1

# first-admin bootstrap (only used when user table is empty)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# legacy migration (only used by scripts/migrate-legacy-db.ts)
LEGACY_DATABASE_URL=
